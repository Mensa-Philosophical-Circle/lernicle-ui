{
  "name": "@lernicle/ui",
  "version": "0.1.1",
  "description": "Shared React components for the Lernicle apps.",
  "license": "UNLICENSED",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fields": {
      "types": "./dist/fields.d.ts",
      "import": "./dist/fields.js"
    },
    "./phone": {
      "types": "./dist/phone.d.ts",
      "import": "./dist/phone.js"
    },
    "./dialogs": {
      "types": "./dist/dialogs.d.ts",
      "import": "./dist/dialogs.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js"
    },
    "./lists": {
      "types": "./dist/lists.d.ts",
      "import": "./dist/lists.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.js"
    },
    "./tailwind-preset": "./theme/tailwind-preset.js",
    "./theme-var.css": "./theme/theme-var.css",
    "./theme-hsl.css": "./theme/theme-hsl.css",
    "./fonts.css": "./theme/fonts.css"
  },
  "files": [
    "dist",
    "theme"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mensa-Philosophical-Circle/lernicle-ui.git"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsup && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:classes": "node scripts/check-classes.mjs",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.13",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-popover": "^1.1.13",
    "@radix-ui/react-select": "^2.2.4",
    "@radix-ui/react-tooltip": "^1.2.6",
    "cmdk": "^1.1.1",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-avatar": "^1.1.9",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-collapsible": "^1.1.10",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-progress": "^1.1.6",
    "@radix-ui/react-radio-group": "^1.3.6",
    "@radix-ui/react-scroll-area": "^1.2.8",
    "@radix-ui/react-separator": "^1.1.6",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-switch": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.0",
    "i18n-iso-countries": "^7.14.0",
    "libphonenumber-js": "^1.12.29",
    "react-phone-number-input": "^3.4.14",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/node": "^4.3.5",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "cmdk": "^1.1.1",
    "jsdom": "^24.1.0",
    "postcss": "^8.5.32",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "^4.1.11",
    "tailwindcss3": "npm:tailwindcss@^3.4.16",
    "tsup": "^8.0.2",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
