{
  "name": "@lernicle/ui",
  "version": "0.0.0",
  "description": "Shared React components for the Lernicle apps.",
  "license": "UNLICENSED",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mensa-Philosophical-Circle/lernicle-ui.git"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:classes": "node scripts/check-classes.mjs",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^24.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "^4.1.11",
    "tsup": "^8.0.2",
    "typescript": "^5.6.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
